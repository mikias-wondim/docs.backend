@model Infrastructure.Services.Email.Models.EmailLinkTemplateModel

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Email Verification</title>
</head>
<body style="margin: 0; padding: 0; background-color: #e5e7eb; font-family: 'Segoe UI', sans-serif; color: #1f2937;">

    <div style="max-width: 600px; margin: 40px auto; border-radius: 12px; padding: 40px 32px; box-shadow: 0 8px 20px rgba(0,0,0,0.05);">

        <!-- Header -->
        <div style="text-align: center; margin-bottom: 32px;">
            <h1 style="font-size: 24px; font-weight: 700; color: #1e293b; margin: 0;">Welcome to ET Docs</h1>
            <p style="font-size: 15px; color: #6b7280; margin-top: 8px;">Verify your email to activate your account</p>
        </div>

        <!-- Card Content -->
        <div style="border: 1px solid #d1d5db; border-radius: 10px; padding: 24px 20px;">

            <p style="font-size: 16px; line-height: 1.6; margin-bottom: 24px;">
                Thank you for signing up! To complete your registration, please verify your email address by clicking the button below:
            </p>

            <!-- Button -->
            <div style="text-align: center; margin: 30px 0;">
                <a href="@Model.Link"
                   style="display: inline-block; background-color: #2563eb; color: #ffffff; padding: 14px 28px; font-size: 16px; font-weight: 600; border-radius: 6px; text-decoration: none;">
                    Verify My Email
                </a>
            </div>

            <!-- Fallback Link -->
            <p style="font-size: 14px; color: #4b5563; margin-bottom: 6px;">
                If the button doesn’t work, you can also copy and paste the link below into your browser:
            </p>
            <p style="font-size: 14px; word-break: break-word; padding: 10px; border-radius: 6px; color: #1d4ed8;">
                <a href="@Model.Link" style="color: #1d4ed8; text-decoration: none;">
                    @Model.Link
                </a>
            </p>
        </div>

        <!-- Footer -->
        <div style="text-align: center; font-size: 13px; color: #6b7280; margin-top: 32px;">
            <p>If you didn’t request this email, no action is needed and you can safely ignore it.</p>
            <p>© @Model.CurrentYear ET Docs. All rights reserved.</p>
        </div>

    </div>
</body>
</html>
