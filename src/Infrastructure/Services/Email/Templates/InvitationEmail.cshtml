@model Infrastructure.Services.Email.Models.EmailInvitationTemplateModel
@{
Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Project Invitation</title>
</head>
<body style="margin: 0; padding: 0; background-color: #f3f4f6; font-family: 'Segoe UI', sans-serif; color: #1f2937;">

<div style="max-width: 600px; margin: 40px auto; border-radius: 12px; padding: 40px 32px; background-color: #ffffff; box-shadow: 0 8px 20px rgba(0,0,0,0.05);">

    <!-- Header -->
    <div style="text-align: center; margin-bottom: 32px;">
        <h1 style="font-size: 24px; font-weight: 700; color: #1e293b; margin: 0;">You're Invited to Join a Project</h1>
        <p style="font-size: 15px; color: #6b7280; margin-top: 8px;">@Model.InvitedBy has invited you to collaborate</p>
    </div>

    <!-- Card Content -->
    <div style="border: 1px solid #e5e7eb; border-radius: 10px; padding: 24px 20px; background-color: #f9fafb;">

        <p style="font-size: 16px; line-height: 1.6; margin-bottom: 16px;">
            You've been invited to join the project <strong>@Model.ProjectName</strong> as a <strong>@Model.Role.ToString()</strong>.
        </p>

        <div style="margin: 20px 0; padding: 12px 16px; background-color: #f3f4f6; border-radius: 8px; font-size: 14px; color: #374151;">
            <p><strong>Invitation Sent:</strong> @Model.SentAt.ToString("f") UTC</p>
            <p><strong>Expires At:</strong> @Model.ExpiresAt.ToString("f") UTC</p>
        </div>

        <!-- Button -->
        <div style="text-align: center; margin: 30px 0;">
            <a href="@Model.Link"
               style="display: inline-block; background-color: #2563eb; color: #ffffff; padding: 14px 28px; font-size: 16px; font-weight: 600; border-radius: 6px; text-decoration: none;">
                View Invitation
            </a>
        </div>

        <!-- Fallback Link -->
        <p style="font-size: 14px; color: #4b5563; margin-bottom: 6px;">
            If the button doesn’t work, you can also copy and paste this link into your browser:
        </p>
        <p style="font-size: 14px; word-break: break-word; color: #1d4ed8; margin-bottom: 12px;">
            <a href="@Model.Link" style="color: #1d4ed8; text-decoration: none;">@Model.Link</a>
        </p>

        <p style="font-size: 13px; color: #6b7280; margin-top: 20px;">
            If you didn’t request this, you can safely ignore this email.
        </p>
    </div>

    <!-- Footer -->
    <div style="text-align: center; font-size: 13px; color: #9ca3af; margin-top: 32px;">
        <p>© @Model.CurrentYear ET Docs. All rights reserved.</p>
    </div>

</div>
</body>
</html>
