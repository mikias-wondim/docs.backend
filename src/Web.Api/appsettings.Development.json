{
  "ConnectionStrings": {
    "Database": "Server=localhost\\SQLEXPRESS;Database=docs;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "Seq",
        "Args": { "ServerUrl": "http://seq:5341" }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "Jwt": {
    "Secret": "super-duper-secret-value-that-should-be-in-user-secrets",
    "Issuer": "Docs",
    "Audience": "Docs.User",
    "ExpirationInMinutes": 60
  },
  "Email": {
    "SmtpHost": "smtp.office365.com",
    "SmtpPort": 587,
    "FromEmail": "ethiopianservices@ethiopianairlines.com",
    "FromName": "ET Docs (Dev)",
    "SmtpPassword": "habtu@ETS2022"
  },
  "FrontEnd": {
    "BaseUrl": "http://localhost:3000",
    "VerifyEmail": "/verify-email",
    "RespondToInvitation": "/dashboard/projects/invitations"
  }
}
